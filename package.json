{
	"name": "hit-website",
	"type": "module",
	"packageManager": "pnpm@11.1.0",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"format:check": "prettier . --cache --check",
		"format:fix": "pnpm run format:check --write",
		"get-data": "pnpm tsx ./scripts/fetch-data.ts",
		"process-data": "pnpm tsx ./scripts/preprocess/preprocess-data.ts",
		"split-mss-json": "pnpm tsx ./scripts/export/makeSingleJson.ts",
		"zod-data": "pnpm tsx ./scripts/preprocess/data-loader.ts",
		"generate-tei": "node ./scripts/export/tei/generate-tei.js",
		"generate-tex": "node ./scripts/export/tex/generate-tex.js",
		"generate-index": "node ./scripts/search-index/generate-search-index.js && node ./scripts/search-index/generate-strata-index.js",
		"build": "astro build",
		"start": "astro preview",
		"astro": "astro",
		"typecheck": "tsc --noEmit",
		"generate-oai-pmh": "node ./scripts/export/oai-pmh/generate-oai-pmh.ts"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^1.0.7",
		"@astrojs/check": "^0.9.9",
		"@astrojs/svelte": "^9.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource/inter": "^5.2.8",
		"@iconify-json/lucide": "^1.2.80",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@xmldom/xmldom": "github:xmldom/xmldom",
		"astro": "^7.1.3",
		"astro-icon": "^1.1.5",
		"d3": "^7.9.0",
		"echarts": "^6.0.0",
		"eta": "^3.5.0",
		"fast-xml-parser": "^5.3.2",
		"html2canvas": "^1.4.1",
		"instantsearch.css": "^8.18.0",
		"instantsearch.js": "^4.106.0",
		"jspdf": "^2.5.2",
		"leaflet": "^1.9.4",
		"leaflet.markercluster": "^1.5.3",
		"lucide": "^1.25.0",
		"node-fetch": "^3.3.2",
		"sharp": "^0.33.5",
		"svelte": "^5.56.7",
		"tabulator-tables": "^6.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.21.0",
		"typesense": "^3.0.6",
		"typesense-instantsearch-adapter": "^3.0.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@acdh-oeaw/prettier-config": "^2.0.1",
		"@types/node": "^22.19.2",
		"@types/tabulator-tables": "^6.3.0",
		"prettier": "^3.7.4",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^6.0.3"
	}
}

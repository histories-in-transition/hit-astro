---
const { manuscript } = Astro.props;
import Section from "@/components/ui/Section.astro";
import NavLink from "@/components/nav-link.astro";
import { Icon } from "astro-icon/components";
---

<Section heading="Bibliographie" id="msBibliography">
	<ul class="list-disc list-inside p-4">
		{
			manuscript.bibliography.map((bibl) => (
				<li>
					{bibl.author}. {bibl.title}{" "}
					<NavLink
						href={bibl.url}
						target="_blank"
						class="cursor-pointer text-brand-900 underline decoration-dotted underline-offset-4"
					>
						Zotero <Icon name="lucide:external-link" class="inline-block align-middle" />
					</NavLink>
				</li>
			))
		}
	</ul>
</Section>
